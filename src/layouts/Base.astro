---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import VisualPanel from '../components/VisualPanel.astro';
import { site } from '../config/site';
import type { Visual } from '../lib/visuals';

interface Props {
  title?: string;
  description?: string;
  /** Set for blog posts so link previews show the right type. */
  type?: 'website' | 'article';
  /** Palette for the split layout's visual panel. */
  visual?: Visual;
}

const { title, description = site.description, type = 'website', visual = 'home' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Writing`} href="/rss.xml" />
    <meta name="theme-color" content="#07070c" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />

    <!-- Runs before paint so reveal animations never flash content without JS. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>
    <Header />
    <VisualPanel visual={visual} />
    <div class="split-content">
      <main id="main">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      import '../scripts/interactions';
      import '../scripts/split';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 200;
    padding: 0.5rem 1rem;
    background: var(--text);
    color: var(--bg);
    border-radius: 0.5rem;
    transition: top 0.2s;
  }
  .skip-link:focus { top: 1rem; }

  .cursor-glow {
    position: fixed;
    top: -300px;
    left: -300px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    opacity: 0;
    background: radial-gradient(circle, rgb(124 92 255 / 0.12), transparent 60%);
    transition: opacity 0.4s;
  }

  main { position: relative; z-index: 1; }

  /*
   * Split layout: a fixed 40% visual panel and a 60% content column.
   * scripts/split.ts sets data-split="start" (panel right) or "end" (panel
   * left) on <html>; the swap is a fixed-length transition, never scroll-linked,
   * so it can't be left half-way. Without JS the layout stays in "start".
   */
  :global(:root) {
    --panel-width: 40%;
    --content-width: 60%;
    --header-height: 4rem;
    --split-duration: 0.9s;
  }

  @media (min-width: 860px) {
    :global(.visual-panel) {
      position: fixed;
      top: var(--header-height);
      bottom: 0;
      left: var(--content-width);
      width: var(--panel-width);
      z-index: 0;
      overflow: hidden;
      will-change: transform;
    }
    .split-content {
      width: var(--content-width);
      will-change: transform;
    }

    /* -150% of the panel's own 40% width = 60% of the viewport: right edge → left edge. */
    :global([data-split='end'] .visual-panel) { transform: translateX(-150%); }
    /* 66.667% of the column's own 60% width = 40% of the viewport. */
    :global([data-split='end']) .split-content { transform: translateX(66.667%); }

    :global([data-split-animate] .visual-panel),
    :global([data-split-animate]) .split-content {
      transition: transform var(--split-duration) var(--ease-out);
    }

    /*
     * The panel briefly passes behind the text mid-swap; dip its opacity so the
     * text stays readable. data-split-swap is only set on real swaps, so the dip
     * never plays on load. One keyframe per direction so it replays on every
     * swap (changing animation-name restarts the animation).
     */
    :global([data-split-swap='end'] .visual-panel) { animation: panel-dip-a var(--split-duration) ease-in-out; }
    :global([data-split-swap='start'] .visual-panel) { animation: panel-dip-b var(--split-duration) ease-in-out; }
  }

  @keyframes panel-dip-a { 50% { opacity: 0.35; } }
  @keyframes panel-dip-b { 50% { opacity: 0.35; } }

  /* Phones and small tablets: the visual becomes a banner above the content. */
  @media (max-width: 859.98px) {
    :global(.visual-panel) {
      position: relative;
      display: block;
      height: 35svh;
      overflow: hidden;
    }
  }
</style>
