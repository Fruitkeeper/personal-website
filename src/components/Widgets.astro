---
import { widgets } from '../config/site';
import { groupBySide } from '../lib/columns';
import { slugify } from '../lib/slug';
import MarketsWidget from './widgets/MarketsWidget.astro';
import ChessWidget from './widgets/ChessWidget.astro';
import BasketballWidget from './widgets/BasketballWidget.astro';
import MagicWidget from './widgets/MagicWidget.astro';
import ProjectWidget from './widgets/ProjectWidget.astro';
import ProjectPanel from './panels/ProjectPanel.astro';
import MarketsPanel from './panels/MarketsPanel.astro';
import BasketballPanel from './panels/BasketballPanel.astro';
import ChessPanel from './panels/ChessPanel.astro';
import MagicPanel from './panels/MagicPanel.astro';

const items = widgets.map((w) => ({ ...w, id: `widget-${slugify(w.title)}` }));
const { left, right } = groupBySide(items);
/** Resting angle per widget (deg), so they read as scattered objects, not a grid. */
const ROT = [-2.2, 1.6, -1, 2.4, -1.8];
---

<section class="widgets" aria-label="Things to explore">
  {
    [left, right].map((column, c) => (
      <div class:list={['col', c === 0 ? 'left' : 'right']}>
        {column.map((w, i) => (
          <button
            type="button"
            class="widget"
            data-widget-kind={w.kind}
            data-open-dialog={w.id}
            data-tilt
            aria-haspopup="dialog"
            aria-controls={w.id}
            style={`--widget: ${w.color}; --rot: ${ROT[(c * 3 + i) % ROT.length]}deg; --delay: ${(c + i * 2) * 70 + 300}ms; --phase: ${-(c * 2.3 + i * 1.7)}s`}
          >
            <span class="sr-only">{w.title}: {w.summary}.</span>
            {w.kind === 'markets' && <MarketsWidget />}
            {w.kind === 'chess' && <ChessWidget />}
            {w.kind === 'basketball' && <BasketballWidget />}
            {w.kind === 'magic' && <MagicWidget />}
            {w.kind === 'project' && <ProjectWidget widget={w} />}
          </button>
        ))}
      </div>
    ))
  }
</section>

{
  items.map((w) => (
    <dialog id={w.id} class="panel" aria-labelledby={`${w.id}-title`} data-widget-kind={w.kind} style={`--widget: ${w.color}`}>
      <form method="dialog">
        <button class="close" aria-label="Close">×</button>
      </form>
      <h2 id={`${w.id}-title`}>
        <span class="dot" aria-hidden="true" />
        {w.title}
      </h2>
      {w.kind === 'project' && <ProjectPanel widget={w} />}
      {w.kind === 'markets' && <MarketsPanel />}
      {w.kind === 'basketball' && <BasketballPanel />}
      {w.kind === 'chess' && <ChessPanel />}
      {w.kind === 'magic' && <MagicPanel />}
    </dialog>
  ))
}

<script>
  import { mountDialogs } from '../scripts/dialogs';
  import { mountTilt } from '../scripts/tilt';
  import { mountMarkets } from '../scripts/markets';
  import { mountToastketball } from '../scripts/toastketball';
  import { mountChess } from '../scripts/chess';
  import { mountMagic } from '../scripts/magic';
  mountDialogs();
  mountTilt();
  mountMarkets();
  mountToastketball();
  mountChess();
  mountMagic();
</script>

<style>
  /*
   * Desktop: two columns of widgets either side of the toaster (which is a
   * fixed full-screen stage behind, centered). Phones: a 2-up grid below it.
   */
  .widgets {
    position: fixed;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(14rem, 17rem) 1fr minmax(14rem, 17rem);
    align-items: center;
    padding: 7rem clamp(1.25rem, 3.5vw, 2.5rem) 2rem;
    pointer-events: none;
  }
  .col { display: grid; gap: 1.4rem; pointer-events: auto; }
  .left { grid-column: 1; justify-items: start; }
  /* Leave room for the contact dock in the bottom-right corner. */
  .right { grid-column: 3; justify-items: end; margin-right: 4.5rem; align-self: center; }
  /* Shorter screens: shrink the objects a little so the columns still fit. */
  @media (min-width: 900px) and (max-height: 820px) {
    .col { zoom: 0.86; }
  }
  @media (min-width: 900px) and (max-height: 700px) {
    .col { zoom: 0.74; }
  }

  /*
   * Every widget is a physical object: a resting angle, a slow float (out of
   * sync with its neighbours), a 3D tilt toward the cursor (scripts/tilt.ts
   * sets --rx/--ry) and a glare that follows it (--gx/--gy).
   */
  .widget {
    position: relative;
    display: block;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    border-radius: 0.7rem;
    transform: perspective(900px) rotate(var(--rot, 0deg)) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-style: preserve-3d;
    transition: transform 0.5s var(--ease-out), filter 0.3s;
    animation:
      pop-in 0.8s var(--delay, 0ms) var(--ease-out) both,
      float 7s var(--phase, 0s) ease-in-out infinite;
  }
  @keyframes pop-in { from { opacity: 0; scale: 0.92; } }
  @keyframes float { 50% { translate: 0 -7px; } }
  .widget:hover, .widget:focus-visible {
    --rot: 0deg;
    transition: transform 0.15s linear, filter 0.3s;
    filter: drop-shadow(0 20px 30px color-mix(in srgb, var(--widget) 35%, transparent));
    z-index: 1;
  }
  .widget:focus-visible { outline: 2px solid var(--widget); outline-offset: 6px; }
  /* Glare: a soft highlight that follows the cursor across the object. */
  .widget::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--gx, 50%) var(--gy, 0%), rgb(255 255 255 / 0.22), transparent 55%);
    mix-blend-mode: soft-light;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .widget:hover::after { opacity: 1; }

  @media (max-width: 899.98px) {
    .widgets {
      position: relative;
      inset: auto;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
      align-items: stretch;
      gap: 0.9rem;
      padding: 0 1.25rem 2rem;
    }
    .col { display: contents; }
    .right { margin: 0; }
    .widget { justify-self: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    .widget { animation: none; transform: rotate(var(--rot, 0deg)); }
  }

  /* Panels (dialogs) */
  .panel {
    /* Tailwind's preflight zeroes margins; restore the UA centering for modals. */
    margin: auto;
    width: min(32rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    padding: 2rem;
    color: var(--text);
    background: rgb(16 16 26 / 0.9);
    border: 1px solid color-mix(in srgb, var(--widget) 30%, var(--border));
    border-radius: var(--radius);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8), 0 0 60px -30px var(--widget);
  }
  .panel[open] { animation: panel-in 0.35s var(--ease-out); }
  .panel::backdrop { background: rgb(4 4 8 / 0.55); backdrop-filter: blur(3px); }
  @keyframes panel-in { from { opacity: 0; transform: translateY(12px) scale(0.97); } }
  .panel h2 { display: flex; align-items: center; gap: 0.6rem; font-size: 1.6rem; margin: 0 0 1rem; }
  .panel h2 .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--widget);
    box-shadow: 0 0 10px var(--widget);
    flex: none;
    transition: background 1s, box-shadow 1s;
  }
  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { color: var(--text); background: var(--surface); }
</style>
