---
import type { Planet } from '../../config/site';

interface Props {
  planet: Extract<Planet, { kind: 'project' }>;
}

const { planet } = Astro.props;
---

<p>{planet.description}</p>
<ul class="tags" aria-label="Technologies">
  {planet.tags.map((t) => <li>{t}</li>)}
</ul>
{
  planet.links && planet.links.length > 0 && (
    <p class="links">
      {planet.links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer">
          {l.label} ↗
        </a>
      ))}
    </p>
  )
}

<style>
  p { color: var(--text-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2em 0.65em;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .links { margin: 1.25rem 0 0; display: flex; gap: 1rem; }
  .links a { color: var(--planet); text-decoration: none; font-weight: 500; }
</style>
