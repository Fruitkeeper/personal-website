---
import type { Widget } from '../../config/site';
import { crest } from '../../lib/crest';

interface Props {
  widget: Extract<Widget, { kind: 'project' }>;
  /** Position in the deck, printed like a sticker number. */
  index?: number;
}

const { widget, index = 1 } = Astro.props;
const initials = crest(widget.title);
---

<div class="sticker">
  <span class="holo" aria-hidden="true"></span>
  <div class="top">
    <span class="crest" aria-hidden="true">{initials}</span>
    <div>
      <p class="name">{widget.title}</p>
      <p class="role">{widget.role}</p>
    </div>
  </div>
  <ul class="positions" aria-label="Stack">
    {widget.tags.map((t) => <li>{t}</li>)}
  </ul>
  <p class="pitch">{widget.summary}</p>
  <p class="foot" aria-hidden="true"><span>{widget.period}</span><span>Nº {String(index).padStart(2, '0')}</span></p>
</div>

<style>
  .sticker {
    position: relative;
    width: 13.5rem;
    padding: 0.8rem 0.85rem 0.6rem;
    border-radius: 0.7rem;
    overflow: hidden;
    text-align: left;
    color: #fff;
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.35);
    background:
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.06) 0 8px, transparent 8px 16px),
      linear-gradient(150deg, color-mix(in srgb, var(--widget) 75%, #1a1033), color-mix(in srgb, var(--widget) 45%, #12091f) 75%);
    border: 3px solid #fff;
    box-shadow: 0 18px 36px -16px rgb(0 0 0 / 0.95), 0 0 0 1px rgb(0 0 0 / 0.3);
  }
  /* Holographic corner, like a rare sticker. */
  .holo {
    position: absolute;
    top: -1.75rem;
    right: -1.75rem;
    width: 3.5rem;
    height: 3.5rem;
    rotate: 45deg;
    background: conic-gradient(#ff7ae0, #7ad7ff, #fff27a, #7affc4, #ff7ae0);
    opacity: 0.85;
    mix-blend-mode: screen;
  }
  /* Keep the title clear of the holo corner. */
  .top { display: flex; align-items: center; gap: 0.6rem; padding-right: 1.1rem; }
  .crest {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.7rem;
    clip-path: polygon(50% 0, 100% 15%, 100% 60%, 50% 100%, 0 60%, 0 15%);
    background: linear-gradient(180deg, #fff, #ffd6ef);
    color: color-mix(in srgb, var(--widget) 55%, #12091f);
    text-shadow: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: -0.02em;
  }
  p { margin: 0; }
  .name { font-family: var(--font-display); font-weight: 700; font-size: 1rem; line-height: 1.1; text-shadow: 0 1px 2px rgb(0 0 0 / 0.35); }
  .role { margin-top: 0.15rem; font-size: 0.68rem; opacity: 0.9; }
  .pitch { margin-top: 0.55rem; font-size: 0.72rem; font-weight: 600; line-height: 1.3; }
  .positions { display: flex; flex-wrap: wrap; gap: 0.3rem; list-style: none; margin: 0.5rem 0 0; padding: 0; }
  .positions li {
    padding: 0.12rem 0.45rem;
    border-radius: 0.25rem;
    background: rgb(0 0 0 / 0.28);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    margin-top: 0.6rem;
    padding-top: 0.35rem;
    border-top: 1px dashed rgb(255 255 255 / 0.4);
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }
</style>
