---
// Seven-segment digit geometry (viewBox 0 0 32 56): segments a–g.
const SEG: Record<string, string> = {
  a: '6,2 26,2 22,6 10,6',
  b: '27,3 27,26 23,23 23,7',
  c: '27,30 27,53 23,49 23,33',
  d: '6,54 26,54 22,50 10,50',
  e: '5,30 9,33 9,49 5,53',
  f: '5,3 9,7 9,23 5,26',
  g: '7,28 10,25 22,25 25,28 22,31 10,31',
};
const DIGITS = 2;
---

<div class="scoreboard">
  <span class="rivet tl" /><span class="rivet tr" /><span class="rivet bl" /><span class="rivet br" />
  <p class="label">Toast-ketball</p>
  <div class="digits" data-sevenseg={DIGITS} aria-hidden="true">
    {
      Array.from({ length: DIGITS }, () => (
        <svg viewBox="0 0 32 56" class="digit">
          {Object.entries(SEG).map(([id, pts]) => <polygon data-seg={id} points={pts} />)}
        </svg>
      ))
    }
  </div>
  <p class="foot"><span class="ball" aria-hidden="true" /> Best streak<span class="sr-only">: <span data-best-streak>0</span></span></p>
</div>

<style>
  .scoreboard {
    position: relative;
    width: 13rem;
    padding: 0.75rem 0.9rem 0.7rem;
    border-radius: 0.5rem;
    background: linear-gradient(180deg, #23252b, #15161a);
    border: 2px solid #33363e;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08), inset 0 -3px 8px rgb(0 0 0 / 0.6), 0 18px 36px -18px rgb(0 0 0 / 0.9);
    text-align: center;
  }
  .rivet { position: absolute; width: 5px; height: 5px; border-radius: 50%; background: radial-gradient(circle at 35% 35%, #8a8f99, #3b3e45); }
  .tl { top: 6px; left: 6px; } .tr { top: 6px; right: 6px; } .bl { bottom: 6px; left: 6px; } .br { bottom: 6px; right: 6px; }
  .label {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #ffb347;
    text-shadow: 0 0 6px rgb(255 140 0 / 0.7);
  }
  .digits {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.3rem;
    background: #070708;
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.9);
  }
  .digit { width: 2.6rem; height: 4.5rem; transform: skewX(-6deg); }
  /* Unlit segments stay faintly visible, like a real LED scoreboard. */
  .digit :global(polygon) { fill: #2a1a0a; transition: fill 0.2s; }
  .digit :global(polygon.on) { fill: #ff9d2e; filter: drop-shadow(0 0 3px #ff7a00) drop-shadow(0 0 8px rgb(255 122 0 / 0.6)); }
  .foot {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8b8f99;
  }
  .ball {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background:
      linear-gradient(90deg, transparent 46%, #3a1d07 46% 54%, transparent 54%),
      linear-gradient(0deg, transparent 46%, #3a1d07 46% 54%, transparent 54%),
      radial-gradient(circle at 35% 35%, #ffb066, #e46a10 70%);
  }
</style>
