---
// An empty board until today's position arrives (scripts/chess.ts fills it).
const cells = Array.from({ length: 64 }, (_, i) => ((Math.floor(i / 8) + i) % 2 ? 'd' : 'l'));
---

<div class="tile" data-cw-tile>
  <div class="frame">
    <div class="board" data-cw-board aria-hidden="true">
      {cells.map((c) => <span class={c} />)}
    </div>
  </div>
  <div class="plate">
    <span class="line" data-cw-line>Daily puzzle</span>
    <span class="turn" data-cw-turn>Can you beat the toaster?</span>
  </div>
  <span class="stamp" aria-hidden="true">Solved</span>
  <span class="sr-only" data-cw-state>Not solved yet</span>
</div>

<style>
  .tile { position: relative; width: 13.5rem; }
  .frame {
    padding: 0.55rem;
    border-radius: 0.55rem;
    background: linear-gradient(145deg, #5b3a22, #3a2414 60%, #2a190e);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.15), inset 0 -2px 4px rgb(0 0 0 / 0.5), 0 18px 36px -18px rgb(0 0 0 / 0.9);
  }
  .board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    aspect-ratio: 1;
    border-radius: 0.2rem;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.5);
  }
  .board :global(span) {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    font-size: 1.25rem;
    line-height: 1;
    font-family: 'Segoe UI Symbol', 'Noto Sans Symbols 2', 'DejaVu Sans', system-ui, sans-serif;
  }
  .board :global(.l) { background: #f0d9b5; }
  .board :global(.d) { background: #b58863; }
  .board :global(.w) { color: #fff; text-shadow: 0 0 1px #000, 0 0 1px #000, 0 1px 1px rgb(0 0 0 / 0.5); }
  .board :global(.b) { color: #1a1410; text-shadow: 0 0 1px rgb(255 255 255 / 0.4); }

  /* Engraved brass plate. */
  .plate {
    display: grid;
    margin: -0.25rem 0.8rem 0;
    padding: 0.35rem 0.6rem 0.4rem;
    border-radius: 0 0 0.4rem 0.4rem;
    background: linear-gradient(180deg, #e8c77a, #b8913f 55%, #8c6a28);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.5), 0 6px 14px -8px rgb(0 0 0 / 0.8);
    color: #4a3410;
    text-align: center;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-shadow: 0 1px 0 rgb(255 240 200 / 0.6);
  }
  .line { font-size: 0.62rem; font-weight: 700; }
  .turn { font-size: 0.56rem; opacity: 0.85; }

  /* Red ink stamp, shown once today's puzzle is solved. */
  .stamp {
    position: absolute;
    top: 38%;
    left: 50%;
    padding: 0.2rem 0.7rem;
    border: 3px double #d42d3a;
    border-radius: 0.3rem;
    color: #d42d3a;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    background: rgb(255 240 230 / 0.15);
    mix-blend-mode: multiply;
    opacity: 0;
    transform: translate(-50%, -50%) rotate(-14deg) scale(1.6);
    transition: opacity 0.3s, transform 0.4s cubic-bezier(0.2, 1.6, 0.4, 1);
    pointer-events: none;
  }
  .tile:global([data-solved]) .stamp { opacity: 0.92; transform: translate(-50%, -50%) rotate(-14deg) scale(1); }
</style>
