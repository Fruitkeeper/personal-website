---
import { markets } from '../../config/site';

// Placeholder tickers until live data arrives (the API's own symbols then show).
const KNOWN: Record<string, string> = { bitcoin: 'BTC', ethereum: 'ETH', solana: 'SOL' };
const ticker = (id: string) => KNOWN[id] ?? id.slice(0, 4).toUpperCase();
---

<div class="term">
  <div class="bar" aria-hidden="true">
    <i></i><i></i><i></i>
    <span>toaster.term — markets</span>
  </div>
  <div class="screen">
    <p class="cmd" aria-hidden="true"><span class="prompt">$</span> watch --coins</p>
    {
      markets.coins.map((id) => (
        <div class="coin" data-mw-coin={id}>
          <p class="row">
            <span class="sym" data-mw-sym>{ticker(id)}</span>
            <span class="price" data-mw-price>······</span>
            <span class="chg" data-mw-change />
          </p>
          <p class="spark" data-mw-spark aria-hidden="true">▁▁▁▁▁▁▁▁▁▁▁▁▁▁</p>
        </div>
      ))
    }
    <p class="mood">mood: <strong data-mw-mood>booting</strong><span class="caret" aria-hidden="true">█</span></p>
  </div>
</div>

<style>
  .term {
    --phosphor: #7cffb2;
    --down: #ff6b81;
    width: 17.5rem;
    border-radius: 0.7rem;
    overflow: hidden;
    background: #0b0f0d;
    border: 1px solid #1d2a23;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.6), 0 18px 40px -18px rgb(0 0 0 / 0.9), 0 0 40px -18px rgb(124 255 178 / 0.35);
    font-family: var(--font-mono);
    text-align: left;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.7rem;
    background: linear-gradient(#18201c, #121815);
    border-bottom: 1px solid #1d2a23;
    font-size: 0.62rem;
    color: #5f7a6b;
  }
  .bar i { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #2a3a31; }
  .bar i:first-child { background: #ff5f57; }
  .bar i:nth-child(2) { background: #febc2e; }
  .bar i:nth-child(3) { background: #28c840; }
  .bar span { margin-left: 0.4rem; }

  .screen {
    position: relative;
    padding: 0.7rem 0.85rem 0.8rem;
    color: var(--phosphor);
    font-size: 0.74rem;
    line-height: 1.5;
    text-shadow: 0 0 6px rgb(124 255 178 / 0.55);
    background: radial-gradient(120% 90% at 50% 40%, #0d1712, #050806);
  }
  /* Scanlines + a soft vignette, like a CRT. */
  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.22) 0 1px, transparent 1px 3px),
      radial-gradient(130% 100% at 50% 50%, transparent 60%, rgb(0 0 0 / 0.55));
  }
  p { margin: 0; }
  .cmd { color: #4c7a62; text-shadow: none; margin-bottom: 0.35rem; }
  .prompt { color: var(--phosphor); }
  .coin + .coin { margin-top: 0.3rem; }
  .row { display: grid; grid-template-columns: 2.4rem 1fr auto; gap: 0.4rem; }
  .sym { font-weight: 700; }
  .price { color: #d7ffe9; }
  .chg { font-weight: 600; }
  .chg:global(.up) { color: var(--phosphor); }
  .chg:global(.down) { color: var(--down); text-shadow: 0 0 6px rgb(255 107 129 / 0.6); }
  .spark { letter-spacing: -0.04em; font-size: 0.95rem; line-height: 1.05; opacity: 0.9; }
  .spark:global(.down) { color: var(--down); text-shadow: 0 0 6px rgb(255 107 129 / 0.5); }
  .mood { margin-top: 0.55rem; color: #a5f3c8; }
  .mood strong { font-weight: 700; color: var(--widget); text-shadow: 0 0 8px var(--widget); transition: color 1s; }
  .caret { margin-left: 0.15rem; animation: blink 1.05s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
</style>
