---
import { credits } from '../config/site';
---

{
  credits.length > 0 && (
    <p class="credits">
      {credits.map((c) => (
        <span>
          “<a href={c.href} target="_blank" rel="noopener">{c.work}</a>” by {c.author},{' '}
          <a href={c.licenseHref} target="_blank" rel="noopener license">{c.license}</a>
        </span>
      ))}
    </p>
  )
}

<style>
  /* Required by the model's CC BY-NC license; kept as quiet as possible. */
  .credits {
    position: fixed;
    right: 1rem;
    bottom: 0.75rem;
    margin: 0;
    font-size: 0.7rem;
    color: var(--text-muted);
    opacity: 0.6;
    z-index: 10;
  }
  .credits:hover { opacity: 1; }
  a { color: inherit; text-decoration: underline; text-decoration-color: var(--border); }
</style>
