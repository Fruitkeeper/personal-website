---
import { projects } from '../config/site';
import { slugify } from '../lib/slug';

const items = projects.map((p) => ({ ...p, id: `project-${slugify(p.title)}` }));
---

<!-- Orbit lines; sized by scripts/orbit.ts. Behind the toaster (z 0), whose canvas is transparent. -->
<svg class="rings" aria-hidden="true" data-orbit-rings>
  {items.map(() => <ellipse cx="50%" cy="50%" rx="0" ry="0" />)}
</svg>

<ul class="orbit" aria-label="Projects">
  {
    items.map((p) => (
      <li class="orbit-item" data-orbit-item style={`--planet: ${p.color}`}>
        <button type="button" class="planet-btn" aria-haspopup="dialog" aria-controls={p.id} data-open-dialog={p.id}>
          <span class="planet" aria-hidden="true" />
          <span class="name">{p.title}</span>
          <span class="summary">{p.summary}</span>
        </button>
      </li>
    ))
  }
</ul>

{
  items.map((p) => (
    <dialog id={p.id} class="project" aria-labelledby={`${p.id}-title`} style={`--planet: ${p.color}`}>
      <form method="dialog">
        <button class="close" aria-label="Close">×</button>
      </form>
      <span class="planet dialog-planet" aria-hidden="true" />
      <h2 id={`${p.id}-title`}>{p.title}</h2>
      <p>{p.description}</p>
      <ul class="tags" aria-label="Technologies">
        {p.tags.map((t) => <li>{t}</li>)}
      </ul>
      {p.links && p.links.length > 0 && (
        <p class="links">
          {p.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          ))}
        </p>
      )}
    </dialog>
  ))
}

<script>
  import { mountOrbit } from '../scripts/orbit';
  mountOrbit();
</script>

<style>
  .rings {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }
  .rings ellipse {
    fill: none;
    stroke: rgb(255 255 255 / 0.07);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }

  .orbit { list-style: none; margin: 0; padding: 0; }

  /*
   * Planets sit above the toaster stage (z-index 1) so every one is
   * clickable. scripts/orbit.ts sets the transform every frame.
   */
  .orbit-item {
    position: fixed;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    will-change: transform;
  }

  .planet-btn {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--text);
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  /* A lit sphere: highlight top-left, the planet's color, shadow bottom-right, plus a glow. */
  .planet {
    display: block;
    width: var(--size, 2.6rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 28%, rgb(255 255 255 / 0.85), transparent 22%),
      radial-gradient(circle at 35% 35%, var(--planet), color-mix(in srgb, var(--planet) 35%, #05050a) 75%);
    box-shadow:
      0 0 18px -2px color-mix(in srgb, var(--planet) 70%, transparent),
      0 0 50px -10px var(--planet),
      inset -6px -8px 14px rgb(0 0 0 / 0.45);
    transition: scale 0.35s var(--ease-out), box-shadow 0.35s;
  }
  /* Vary planet sizes a little for a less uniform system. */
  .orbit-item:nth-child(4n + 1) { --size: 2.9rem; }
  .orbit-item:nth-child(4n + 2) { --size: 2.3rem; }
  .orbit-item:nth-child(4n + 3) { --size: 3.3rem; }
  .orbit-item:nth-child(4n + 4) { --size: 2.6rem; }

  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.9);
  }
  .summary {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s, transform 0.3s var(--ease-out);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.9);
  }
  .planet-btn:hover .planet, .planet-btn:focus-visible .planet {
    scale: 1.18;
    box-shadow:
      0 0 26px 2px color-mix(in srgb, var(--planet) 80%, transparent),
      0 0 80px -6px var(--planet),
      inset -6px -8px 14px rgb(0 0 0 / 0.45);
  }
  .planet-btn:hover .summary, .planet-btn:focus-visible .summary { opacity: 1; transform: none; }
  .planet-btn:focus-visible { outline: none; }
  .planet-btn:focus-visible .planet { outline: 2px solid var(--accent-2); outline-offset: 4px; }

  @media (max-width: 600px) {
    .name { font-size: 0.75rem; white-space: normal; max-width: 6.5rem; }
    .summary { display: none; }
    .orbit-item { --size: 2.2rem !important; }
  }

  /* Project dialog */
  .project {
    /* Tailwind's preflight zeroes margins; restore the UA centering for modals. */
    margin: auto;
    width: min(32rem, calc(100vw - 2rem));
    padding: 2rem;
    color: var(--text);
    background: rgb(16 16 26 / 0.88);
    border: 1px solid color-mix(in srgb, var(--planet) 30%, var(--border));
    border-radius: var(--radius);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8), 0 0 60px -30px var(--planet);
  }
  .project[open] { animation: pop 0.35s var(--ease-out); }
  .project::backdrop { background: rgb(4 4 8 / 0.55); backdrop-filter: blur(3px); }
  @keyframes pop { from { opacity: 0; transform: translateY(12px) scale(0.97); } }
  .dialog-planet { --size: 2.4rem; margin-bottom: 1rem; }

  .project h2 { font-size: 1.75rem; margin-bottom: 0.75rem; }
  .project p { color: var(--text-muted); }
  .close {
    position: absolute;
    top: 0.75rem;
    right: 0.9rem;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-muted);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .close:hover { color: var(--text); background: var(--surface); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 1rem 0 0; }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2em 0.65em;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .links { margin: 1.25rem 0 0; display: flex; gap: 1rem; }
  .links a { color: var(--planet); text-decoration: none; font-weight: 500; }
</style>
