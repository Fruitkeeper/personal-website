---
import { site } from '../config/site';
---

<section class="hero">
  <div class="container content">
    <p class="eyebrow" data-reveal>{site.role}</p>
    <h1 data-reveal style="--reveal-delay: 100ms">
      Hi, I'm <span class="gradient-text">{site.name}</span>.
    </h1>
    <p class="tagline" data-reveal style="--reveal-delay: 200ms">{site.tagline}</p>
    <div class="actions" data-reveal style="--reveal-delay: 300ms">
      <a href="/projects" class="btn primary">See my work</a>
      <a href={`mailto:${site.email}`} class="btn ghost">Get in touch</a>
    </div>
  </div>

  <a href="#featured" class="scroll-hint" aria-label="Scroll to featured projects">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
  }
  @media (min-width: 860px) {
    .hero { min-height: calc(100dvh - var(--header-height)); }
  }

  .content { position: relative; padding-block: 4rem; pointer-events: none; }
  .content > * { pointer-events: auto; max-width: 40rem; }
  h1 { margin-bottom: 1.25rem; }
  .tagline { font-size: clamp(1.1rem, 2.2vw, 1.35rem); color: var(--text-muted); margin-bottom: 2.25rem; }

  .actions { display: flex; gap: 0.85rem; flex-wrap: wrap; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s, background 0.3s;
  }
  .btn:hover { transform: translateY(-2px); color: inherit; }
  .primary { background: var(--gradient); color: white; box-shadow: 0 8px 30px -8px rgb(124 92 255 / 0.6); }
  .primary:hover { color: white; box-shadow: 0 12px 40px -8px rgb(124 92 255 / 0.8); }
  .ghost { border: 1px solid var(--border); background: var(--surface); backdrop-filter: blur(8px); }
  .ghost:hover { background: rgb(255 255 255 / 0.08); }

  .scroll-hint {
    display: none;
    position: absolute;
    bottom: 2rem;
    left: 50%;
    translate: -50% 0;
    width: 1.5rem;
    height: 2.4rem;
    border: 2px solid var(--border);
    border-radius: 999px;
  }
  .scroll-hint span {
    position: absolute;
    top: 0.4rem;
    left: 50%;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--text-muted);
    animation: scroll 1.8s ease-in-out infinite;
  }
  @media (min-width: 860px) { .scroll-hint { display: block; } }
  @keyframes scroll {
    0% { opacity: 0; transform: translateY(0); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(12px); }
  }

  /* On narrow screens the blob sits behind the text; dim it for legibility. */
  @media (max-width: 768px) {
    .scene { opacity: 0; }
    .scene[data-ready] { opacity: 0.55; }
  }
</style>
