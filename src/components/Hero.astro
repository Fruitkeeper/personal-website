---
import { site } from '../config/site';
import Toaster from './Toaster.astro';
import Moons from './Moons.astro';

// First name on its own line, so a long surname never breaks at a hyphen.
const [first, ...rest] = site.name.split(' ');
const last = rest.join(' ');
---

<section class="hero" aria-labelledby="hero-name">
  <div class="copy">
    <p class="hello">Hi, I'm</p>
    <h1 id="hero-name">
      <span>{first}</span>
      {last && <span class="last">{last}</span>}
    </h1>
    <p class="headline">{site.headline}</p>
    <p class="intro">{site.intro}</p>
    <div class="actions">
      <a class="btn primary" href="#work">See my work</a>
      <a class="btn" href="#contact">Say hi</a>
      <a class="more" href="/about">About me <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="stage">
    <Toaster />
    <Moons />
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: 2rem;
    min-height: calc(100dvh - 4rem);
    max-width: 76rem;
    margin: 0 auto;
    padding: 2rem clamp(1.25rem, 4vw, 3rem) 3rem;
  }
  .copy > * { animation: rise 0.9s var(--ease-out) both; }
  .copy > :nth-child(2) { animation-delay: 0.06s; }
  .copy > :nth-child(3) { animation-delay: 0.12s; }
  .copy > :nth-child(4) { animation-delay: 0.18s; }
  .copy > :nth-child(5) { animation-delay: 0.24s; }
  @keyframes rise { from { opacity: 0; transform: translateY(12px); } }

  .hello { margin: 0 0 0.6rem; font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.08em; color: var(--accent-2); }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    line-height: 0.95;
    letter-spacing: -0.04em;
    background: linear-gradient(180deg, #fff 30%, #b9b6cc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  h1 span { display: block; }
  .last { white-space: nowrap; }
  .headline { margin: 1.1rem 0 0; font-family: var(--font-display); font-size: clamp(1.35rem, 2.6vw, 1.9rem); font-weight: 500; line-height: 1.25; }
  .intro { margin: 1rem 0 0; max-width: 34rem; font-size: 1.05rem; line-height: 1.65; color: var(--text-muted); }

  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 2rem; }
  .btn {
    padding: 0.75rem 1.3rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgb(255 255 255 / 0.04);
    color: var(--text);
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.25s var(--ease-out), background 0.25s, box-shadow 0.25s;
  }
  .btn:hover { transform: translateY(-2px); background: rgb(255 255 255 / 0.08); }
  .primary { border: 0; background: var(--gradient); color: #fff; box-shadow: 0 10px 30px -10px rgb(124 92 255 / 0.7); }
  .primary:hover { background: var(--gradient); box-shadow: 0 14px 36px -10px rgb(124 92 255 / 0.9); }
  .more { margin-left: 0.25rem; color: var(--text-muted); text-decoration: none; font-size: 0.95rem; }
  .more:hover { color: var(--text); }
  .more span { display: inline-block; transition: translate 0.3s var(--ease-out); }
  .more:hover span { translate: 3px 0; }

  .stage { position: relative; height: min(74dvh, 42rem); }

  @media (max-width: 899.98px) {
    .hero { grid-template-columns: 1fr; min-height: auto; gap: 0; padding-top: 1.5rem; }
    .stage { height: 44svh; order: -1; margin: -1rem 0 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .copy > * { animation: none; } }
</style>
