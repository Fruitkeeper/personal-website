---
import { site } from '../config/site';
---

<section class="hero">
  <div class="stage" aria-hidden="true">
    <div class="glow"></div>
    <canvas class="scene" data-toaster-canvas title="Click me"></canvas>
  </div>

  <div class="container content">
    <p class="eyebrow" data-reveal>{site.role}</p>
    <h1 data-reveal style="--reveal-delay: 100ms">
      Hi, I'm <span class="gradient-text">{site.name}</span>.
    </h1>
    <p class="tagline" data-reveal style="--reveal-delay: 200ms">{site.tagline}</p>
    <div class="actions" data-reveal style="--reveal-delay: 300ms">
      <a href="/projects" class="btn primary">See my work</a>
      <a href={`mailto:${site.email}`} class="btn ghost">Get in touch</a>
    </div>
  </div>
</section>

<script>
  // Three.js + the model load on demand, so the text paints first.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-toaster-canvas]');
  if (canvas) {
    import('../scripts/toaster-scene')
      .then(({ mountToasterScene }) => mountToasterScene(canvas))
      .catch((err) => console.warn('Toaster scene failed to load.', err));
  }
</script>

<style>
  .hero {
    min-height: calc(100dvh - 4rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-block: 2rem 4rem;
  }

  .stage {
    position: relative;
    width: min(100%, 34rem);
    height: clamp(16rem, 46dvh, 30rem);
  }
  .scene { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1s var(--ease-out); cursor: pointer; }
  .scene[data-ready] { opacity: 1; }
  /* Soft light behind the toaster; also the placeholder while it loads. */
  .glow {
    position: absolute;
    inset: 10% 15%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(124 92 255 / 0.25), rgb(34 211 238 / 0.08) 45%, transparent 70%);
    filter: blur(30px);
  }

  .content > * { max-width: 40rem; margin-inline: auto; }
  h1 { margin-bottom: 1.25rem; }
  .tagline { font-size: clamp(1.1rem, 2.2vw, 1.35rem); color: var(--text-muted); margin-bottom: 2.25rem; }

  .actions { display: flex; gap: 0.85rem; flex-wrap: wrap; justify-content: center; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s, background 0.3s;
  }
  .btn:hover { transform: translateY(-2px); color: inherit; }
  .primary { background: var(--gradient); color: white; box-shadow: 0 8px 30px -8px rgb(124 92 255 / 0.6); }
  .primary:hover { color: white; box-shadow: 0 12px 40px -8px rgb(124 92 255 / 0.8); }
  .ghost { border: 1px solid var(--border); background: var(--surface); }
  .ghost:hover { background: rgb(255 255 255 / 0.08); }
</style>
