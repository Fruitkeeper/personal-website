---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="page-header container">
  <div class="glow" aria-hidden="true"></div>
  <p class="eyebrow" data-reveal>{eyebrow}</p>
  <h1 data-reveal style="--reveal-delay: 80ms">{title}</h1>
  {lede && <p class="lede" data-reveal style="--reveal-delay: 160ms">{lede}</p>}
  <slot />
</header>

<style>
  .page-header { position: relative; padding-block: clamp(4rem, 10vw, 7rem) 3rem; }
  .glow {
    position: absolute;
    inset: 0 0 auto auto;
    width: min(32rem, 80vw);
    aspect-ratio: 1;
    translate: 20% -40%;
    background: radial-gradient(circle, rgb(124 92 255 / 0.25), rgb(34 211 238 / 0.08) 40%, transparent 70%);
    filter: blur(30px);
    pointer-events: none;
    z-index: -1;
    animation: drift 14s ease-in-out infinite alternate;
  }
  @keyframes drift { to { translate: 5% -25%; } }
  .lede { font-size: 1.25rem; color: var(--text-muted); max-width: 40rem; }
</style>
