---
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <p>© {year} {site.name}</p>
    <ul>
      {site.socials.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label}</a></li>)}
      <li><a href="/rss.xml">RSS</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding-block: 2rem; color: var(--text-muted); font-size: 0.9rem; position: relative; z-index: 1; }
  .inner { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  p { margin: 0; }
  ul { display: flex; gap: 1.25rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  a { text-decoration: none; }
</style>
