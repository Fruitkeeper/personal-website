---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate, readingTime } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">Nothing here yet. The first post is on its way.</p>
  ) : (
    <ol class="list">
      {posts.map((post, i) => (
        <li data-reveal style={`--reveal-delay: ${i * 60}ms`}>
          <a href={`/blog/${post.id}/`} class="row" data-spotlight>
            <div class="meta">
              <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
              <span aria-hidden="true">·</span>
              <span>{readingTime(post.body)} min read</span>
              {post.data.draft && <span class="draft">draft</span>}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        </li>
      ))}
    </ol>
  )
}

<style>
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .row {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: block;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius);
    border: 1px solid transparent;
    text-decoration: none;
    transition: border-color 0.3s, background 0.3s;
    overflow: hidden;
  }
  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(400px circle at var(--mx) var(--my), rgb(124 92 255 / 0.12), transparent 50%);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .row:hover { border-color: var(--border); background: var(--surface); color: inherit; }
  .row:hover::before { opacity: 1; }
  .row:hover h3 { color: var(--accent-2); }
  .meta { display: flex; gap: 0.5rem; align-items: center; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.4rem; }
  .draft { color: var(--accent-3); border: 1px solid currentColor; border-radius: 999px; padding: 0 0.5em; }
  h3 { margin-bottom: 0.3rem; transition: color 0.3s; }
  p { color: var(--text-muted); margin: 0; }
  .empty { color: var(--text-muted); }
</style>
