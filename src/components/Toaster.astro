<div class="stage">
  <div class="glow" aria-hidden="true"></div>
  <canvas class="scene" data-toaster-canvas role="img" aria-label="A sad toaster robot that looks at your cursor" title="Click me"></canvas>
</div>

<script>
  // Three.js + the model load on demand, so the page paints first.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-toaster-canvas]');
  if (canvas) {
    import('../scripts/toaster-scene')
      .then(({ mountToasterScene }) => mountToasterScene(canvas))
      .catch((err) => console.warn('Toaster scene failed to load.', err));
  }
</script>

<style>
  .stage {
    position: fixed;
    inset: 0;
    /* Widgets sit above this (z 2) so they're always clickable — see Widgets.astro. */
    z-index: 1;
    display: grid;
    place-items: center;
  }
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1s var(--ease-out);
    cursor: pointer;
  }
  .scene[data-ready] { opacity: 1; }

  /* Phones: the page scrolls, so the toaster gets its own block under the name. */
  @media (max-width: 899.98px) {
    .stage { position: relative; inset: auto; height: 42svh; }
  }
  /* Soft light behind the toaster; also the placeholder while it loads. */
  .glow {
    width: min(48vmin, 26rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(124 92 255 / 0.22), rgb(34 211 238 / 0.07) 45%, transparent 70%);
    filter: blur(30px);
  }
</style>
