---
// A sparse starfield, generated at build time with a seeded RNG so it's
// identical on every load (no layout shift, no JS).
const COUNT = 110;

function mulberry32(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rand = mulberry32(20261014);
const stars = Array.from({ length: COUNT }, () => ({
  x: (rand() * 100).toFixed(2),
  y: (rand() * 100).toFixed(2),
  size: rand() < 0.85 ? 1 : 2,
  opacity: (0.2 + rand() * 0.5).toFixed(2),
  twinkle: rand() < 0.25,
  delay: (rand() * 6).toFixed(2),
}));
---

<div class="stars" aria-hidden="true">
  {
    stars.map((s) => (
      <span
        class:list={['star', { twinkle: s.twinkle }]}
        style={`left:${s.x}%;top:${s.y}%;width:${s.size}px;height:${s.size}px;opacity:${s.opacity};animation-delay:${s.delay}s`}
      />
    ))
  }
</div>

<style>
  .stars { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  .star { position: absolute; border-radius: 50%; background: #fff; }
  .twinkle { animation: twinkle 4s ease-in-out infinite; }
  @keyframes twinkle { 50% { opacity: 0.05; } }
  @media (prefers-reduced-motion: reduce) { .twinkle { animation: none; } }
</style>
