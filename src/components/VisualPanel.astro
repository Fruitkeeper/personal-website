---
import PanelScene from './PanelScene';
import { paletteStyle, type Visual } from '../lib/visuals';

interface Props {
  visual: Visual;
}

const { visual } = Astro.props;
---

<aside class="visual-panel" data-visual-panel style={paletteStyle(visual)} aria-hidden="true">
  <div class="fallback"></div>
  <!-- client:only: Spline needs the DOM. Loads after the page paints. -->
  <PanelScene client:only="react" />
</aside>

<style>
  /* Fade the panel's edges so the scene dissolves into the nebula instead of
     being cut off by a hard line where the panel ends. */
  .visual-panel {
    --fade: linear-gradient(to right, transparent, #000 14%, #000 86%, transparent);
    -webkit-mask-image: var(--fade);
    mask-image: var(--fade);
  }
  @media (max-width: 859.98px) {
    .visual-panel { --fade: linear-gradient(to bottom, #000 70%, transparent); }
  }

  .fallback, .visual-panel :global(.scene) { position: absolute; inset: 0; width: 100%; height: 100%; }

  /* Shown while Spline loads, and permanently if it can't (no WebGL, offline). */
  .fallback {
    background:
      radial-gradient(45% 35% at 50% 45%, color-mix(in srgb, var(--accent-1) 40%, transparent), transparent 70%),
      radial-gradient(35% 30% at 60% 58%, color-mix(in srgb, var(--accent-2) 30%, transparent), transparent 70%),
      radial-gradient(30% 25% at 40% 38%, color-mix(in srgb, var(--accent-3) 25%, transparent), transparent 70%);
    filter: blur(20px);
    transition: opacity 1.2s;
  }
  .visual-panel :global(.scene) { opacity: 0; transition: opacity 1.2s var(--ease-out); }
  .visual-panel :global(.scene[data-ready]) { opacity: 1; }
  .fallback:has(~ :global(.scene[data-ready])) { opacity: 0; }
</style>
