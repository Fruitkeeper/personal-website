---
import { site } from '../config/site';
---

<header class="intro">
  <h1>{site.name}</h1>
  <p>{site.tagline}</p>
  <a class="about" href="/about">About me <span aria-hidden="true">→</span></a>
</header>

<style>
  .intro {
    position: fixed;
    top: clamp(1.25rem, 3.5vw, 2.5rem);
    left: clamp(1.25rem, 3.5vw, 2.5rem);
    z-index: 5;
    max-width: min(32rem, 90vw);
    pointer-events: none;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    background: linear-gradient(180deg, #fff 30%, #b9b6cc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: rise 0.9s var(--ease-out) both;
  }
  p {
    margin: 0.6rem 0 0;
    font-family: var(--font-mono);
    font-size: clamp(0.72rem, 1vw, 0.85rem);
    letter-spacing: 0.04em;
    color: var(--text-muted);
    animation: rise 0.9s 0.12s var(--ease-out) both;
  }
  .about {
    display: inline-flex;
    gap: 0.4rem;
    margin-top: 0.9rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text);
    text-decoration: none;
    background: rgb(255 255 255 / 0.03);
    pointer-events: auto;
    transition: border-color 0.25s, background 0.25s;
    animation: rise 0.9s 0.24s var(--ease-out) both;
  }
  .about:hover, .about:focus-visible { border-color: var(--accent-2); background: rgb(34 211 238 / 0.08); }
  .about span { transition: translate 0.3s var(--ease-out); }
  .about:hover span { translate: 3px 0; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }

  /* Phones: the page scrolls, so the name sits in the flow above the toaster. */
  @media (max-width: 899.98px) {
    .intro { position: relative; top: 0; left: 0; padding: 1.5rem 1.25rem 0; max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1, p, .about { animation: none; }
  }
</style>
