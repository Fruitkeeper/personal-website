---
import type { Project } from '../config/site';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.length === 0 ? (
    <p class="empty">No projects yet — add some in <code>src/config/site.ts</code>.</p>
  ) : (
    <div class="grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} />
      ))}
    </div>
  )
}

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); gap: 1.25rem; }
  .empty { color: var(--text-muted); }
</style>
