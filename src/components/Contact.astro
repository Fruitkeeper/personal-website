---
import { contact } from '../config/site';

interface Props {
  /** Centered (About page footer) or left-aligned (hero). */
  align?: 'start' | 'center';
}
const { align = 'start' } = Astro.props;

type Icon = 'github' | 'linkedin' | 'x' | 'mail';
const links: { label: string; href: string; icon: Icon; external: boolean }[] = [
  { label: 'GitHub', href: contact.github, icon: 'github', external: true },
  { label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin', external: true },
  { label: 'X', href: contact.x, icon: 'x', external: true },
  { label: 'Email', href: `mailto:${contact.email}`, icon: 'mail', external: false },
];

// Simple Icons (CC0) for brands; Lucide (ISC) for mail.
const paths: Record<Exclude<Icon, 'mail'>, string> = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  x: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
};
---

<div id="contact" class:list={['contact', align]}>
  <a class="email" href={`mailto:${contact.email}`} data-magnet data-copy-email={contact.email} aria-label={`Email ${contact.email} (click to copy)`}>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /></svg>
    <span data-label>{contact.email}</span>
  </a>
  <ul class="socials">
    {
      links
        .filter((l) => l.icon !== 'mail')
        .map((l) => (
          <li>
            <a class="icon" href={l.href} target="_blank" rel="me noopener" aria-label={l.label} title={l.label} data-magnet>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={paths[l.icon as Exclude<Icon, 'mail'>]} />
              </svg>
            </a>
          </li>
        ))
    }
  </ul>
  <p class="sr-only" role="status" aria-live="polite" data-copy-status></p>
</div>

<script>
  import { mountContact } from '../scripts/contact';
  mountContact();
</script>

<style>
  .contact { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .center { justify-content: center; }
  .email, .icon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--border);
    background: rgb(255 255 255 / 0.03);
    color: var(--text-muted);
    text-decoration: none;
    translate: var(--mx, 0) var(--my, 0);
    transition: color 0.25s, border-color 0.25s, background 0.25s, translate 0.2s var(--ease-out);
  }
  .email { padding: 0.55rem 0.95rem; border-radius: 999px; font-family: var(--font-mono); font-size: 0.8rem; }
  .icon { justify-content: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; }
  .email:hover, .email:focus-visible, .icon:hover, .icon:focus-visible { color: var(--text); border-color: rgb(255 255 255 / 0.25); background: rgb(255 255 255 / 0.07); }
  .email[data-copied] { color: var(--accent-2); border-color: rgb(34 211 238 / 0.5); }
  svg { width: 1rem; height: 1rem; flex: none; }
  .socials { display: flex; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
</style>
