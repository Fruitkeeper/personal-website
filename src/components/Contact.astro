---
import { contact } from '../config/site';

type Icon = 'github' | 'linkedin' | 'x' | 'mail';
const links: { label: string; href: string; icon: Icon; external: boolean }[] = [
  { label: 'GitHub', href: contact.github, icon: 'github', external: true },
  { label: 'LinkedIn', href: contact.linkedin, icon: 'linkedin', external: true },
  { label: 'X', href: contact.x, icon: 'x', external: true },
  { label: 'Email', href: `mailto:${contact.email}`, icon: 'mail', external: false },
];

// Simple Icons (CC0) for brands; Lucide (ISC) for mail.
const paths: Record<Exclude<Icon, 'mail'>, string> = {
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  x: 'M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z',
};
---

<nav class="dock" aria-label="Contact">
  <span class="tag" aria-hidden="true">say hi</span>
  <ul>
    {
      links.map((l, i) => (
        <li style={`--i: ${i}`}>
          <a
            class="btn"
            href={l.href}
            data-magnet
            data-copy-email={l.icon === 'mail' ? contact.email : undefined}
            target={l.external ? '_blank' : undefined}
            rel={l.external ? 'me noopener' : undefined}
            aria-label={l.icon === 'mail' ? `Email (copies ${contact.email})` : l.label}
          >
            {l.icon === 'mail' ? (
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d={paths[l.icon]} />
              </svg>
            )}
            <span class="label" data-label aria-hidden="true">{l.icon === 'mail' ? contact.email : l.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<p class="sr-only" role="status" aria-live="polite" data-copy-status></p>


<script>
  import { mountContact } from '../scripts/contact';
  mountContact();
</script>

<style>
  .dock {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  /* Vertical "say hi" label above the dock, with a fading rule. */
  .tag {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .tag::after {
    content: '';
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--text-muted), transparent);
  }

  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; }
  li { animation: dock-in 0.6s var(--ease-out) both; animation-delay: calc(0.6s + var(--i) * 80ms); }
  @keyframes dock-in { from { opacity: 0; transform: translateX(24px) scale(0.6); } }

  .btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: 50%;
    color: var(--text-muted);
    background: rgb(20 20 32 / 0.6);
    border: 1px solid var(--border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-decoration: none;
    transition: color 0.25s, background 0.25s, box-shadow 0.35s, scale 0.35s var(--ease-out), translate 0.2s var(--ease-out);
    /* Set by scripts/contact.ts while the cursor is near. */
    translate: var(--mx, 0) var(--my, 0);
  }
  svg { width: 1.15rem; height: 1.15rem; position: relative; z-index: 1; }

  /* Spinning gradient ring, revealed on hover/focus. */
  .btn::before {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: conic-gradient(var(--accent-1), var(--accent-2), var(--accent-3), var(--accent-1));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
    opacity: 0;
    transition: opacity 0.3s;
    animation: spin 2.5s linear infinite;
  }
  @keyframes spin { to { rotate: 1turn; } }

  .btn:hover, .btn:focus-visible, .btn[data-copied] {
    color: var(--text);
    background: rgb(30 30 48 / 0.85);
    box-shadow: 0 0 28px -4px rgb(34 211 238 / 0.45), 0 0 50px -10px rgb(124 92 255 / 0.5);
    scale: 1.08;
  }
  .btn:hover::before, .btn:focus-visible::before, .btn[data-copied]::before { opacity: 1; }

  /* Label pill that slides out to the left. */
  .label {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgb(16 16 26 / 0.9);
    color: var(--text);
    font-size: 0.8rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translate(10px, -50%);
    transition: opacity 0.25s, transform 0.35s var(--ease-out);
  }
  .btn:hover .label, .btn:focus-visible .label, .btn[data-copied] .label { opacity: 1; transform: translate(0, -50%); }
  .btn[data-copied] .label { color: var(--accent-2); }



  /* Stacked (phone) layout: the page scrolls, so the dock becomes a row at the end of it. */
  @media (max-width: 899.98px) {
    .dock { position: relative; right: auto; bottom: auto; flex-direction: row; justify-content: center; padding: 0 1.25rem 2.5rem; }
    ul { flex-direction: row; gap: 0.8rem; }
    .tag { display: none; }
    /* Labels would slide out sideways off the row; show them below instead. */
    .label { right: auto; left: 50%; top: calc(100% + 0.5rem); transform: translate(-50%, -4px); }
    .btn:hover .label, .btn:focus-visible .label, .btn[data-copied] .label { transform: translate(-50%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    li { animation: none; }
    .btn::before { animation: none; }
  }
</style>
