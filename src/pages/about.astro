---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';
---

<Base title="About" description={`About ${site.name}.`}>
  <PageHeader eyebrow="About" title={`Hi, I'm ${site.name}.`} lede={site.role} />
  <section class="container about">
    <div class="bio">
      {site.bio.map((paragraph, i) => <p data-reveal style={`--reveal-delay: ${i * 80}ms`}>{paragraph}</p>)}
    </div>
    <aside class="card" data-reveal data-spotlight>
      <dl>
        <dt>Based in</dt>
        <dd>{site.location}</dd>
        <dt>Email</dt>
        <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        <dt>Elsewhere</dt>
        <dd>
          <ul>
            {site.socials.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label} ↗</a></li>)}
          </ul>
        </dd>
      </dl>
    </aside>
  </section>
</Base>

<style>
  .about { display: grid; gap: 3rem; grid-template-columns: minmax(0, 1fr); padding-bottom: 6rem; }
  @media (min-width: 860px) { .about { grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr); align-items: start; } }
  .bio p { font-size: 1.15rem; }
  .card { padding: 1.75rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-elevated); }
  dl { margin: 0; display: grid; gap: 0.35rem; }
  dt { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted); margin-top: 0.85rem; }
  dt:first-child { margin-top: 0; }
  dd { margin: 0; overflow-wrap: anywhere; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.25rem; }
  a { text-decoration: none; }
</style>
