---
import Base from '../layouts/Base.astro';
import Stars from '../components/Stars.astro';
import Contact from '../components/Contact.astro';
import { about, projects, site } from '../config/site';
---

<Base title="About" description={`About ${site.name}: ${about.intro[0]}`}>
  <Stars />
  <div class="page">
    <a class="back" href="/"><span aria-hidden="true">←</span> Home</a>

    <header class="hero">
      <p class="eyebrow">About</p>
      <h1>{site.name}</h1>
      <p class="where">{site.location} · {about.education.degree.replace('BSc ', '')}</p>
    </header>

    <section class="intro" aria-label="Introduction">
      {about.intro.map((p, i) => <p class:list={{ lead: i === 0 }}>{p}</p>)}
    </section>

    <section aria-labelledby="exp-title">
      <h2 id="exp-title"><span>01</span> Experience</h2>
      <ol class="timeline">
        {
          about.experience.map((r) => (
            <li style={`--c: ${r.color}`}>
              <span class="node" aria-hidden="true" />
              <div class="when">
                <span>{r.period}</span>
                <span>{r.place}</span>
              </div>
              <div class="what">
                <h3>
                  {r.href ? (
                    <a href={r.href} target="_blank" rel="noopener">
                      {r.org} <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    r.org
                  )}
                  <small>{r.orgNote}</small>
                </h3>
                <p class="role">{r.role}</p>
                <ul>
                  {r.points.map((pt) => <li>{pt}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="side-title">
      <h2 id="side-title"><span>02</span> Projects</h2>
      <div class="side">
        {
          projects.map((p) => (
            <article style={`--c: ${p.color}`}>
              <p class="period">{p.role} · {p.period}</p>
              <h3>{p.title}</h3>
              <p>{p.description}</p>
              <ul class="chips">
                {p.tags.map((t) => <li>{t}</li>)}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="edu-title" class="split">
      <div>
        <h2 id="edu-title"><span>03</span> Education</h2>
        <p class="school">{about.education.school}</p>
        <p class="degree">{about.education.degree} · {about.education.period}</p>
        <ul class="chips">
          {about.education.notes.map((n) => <li>{n}</li>)}
        </ul>
      </div>
      <div>
        <h2 id="tools-title"><span>04</span> Tools &amp; languages</h2>
        <ul class="chips" aria-labelledby="tools-title">
          {about.skills.map((s) => <li>{s}</li>)}
        </ul>
        <ul class="chips soft">
          {about.languages.map((l) => <li>{l}</li>)}
        </ul>
        <p class="talks">Talk: {about.talks.join(' · ')}</p>
      </div>
    </section>
    <footer class="foot">
      <p>Want to talk? Say hi.</p>
      <Contact align="center" />
    </footer>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1.25rem, 4vw, 2.5rem) 8rem;
  }

  .back {
    display: inline-flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back span { transition: translate 0.3s var(--ease-out); }
  .back:hover, .back:focus-visible { color: var(--text); }
  .back:hover span { translate: -3px 0; }
  @media (prefers-reduced-motion: reduce) { .back span { transition: none; } }

  .hero { margin: 2.5rem 0 2.5rem; }
  .eyebrow { margin: 0 0 0.6rem; font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent-2); }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    background: linear-gradient(180deg, #fff 30%, #b9b6cc);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .where { margin: 0.9rem 0 0; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); }

  .intro p { margin: 0 0 1rem; font-size: 1.05rem; line-height: 1.7; color: var(--text-muted); max-width: 40rem; }
  .intro .lead { font-size: clamp(1.25rem, 2.4vw, 1.5rem); line-height: 1.45; color: var(--text); }

  section { margin-top: 4.5rem; }
  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0 0 1.75rem;
    font-size: 1.5rem;
  }
  h2 span { font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent-2); }

  /* Timeline: a glowing rail with a node per role in that role's color. */
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(var(--border), rgb(255 255 255 / 0.04));
  }
  .timeline > li {
    position: relative;
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: 1.5rem;
    padding: 0 0 2.5rem 2.25rem;
  }
  .node {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 4px var(--bg), 0 0 16px var(--c);
  }
  .when { display: grid; align-content: start; gap: 0.2rem; font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); padding-top: 0.2rem; }
  h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.6rem; margin: 0; font-size: 1.25rem; }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { color: var(--c); }
  h3 small { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; color: var(--text-muted); }
  .role { margin: 0.3rem 0 0.75rem; color: var(--c); font-size: 0.9rem; font-weight: 500; }
  .what ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.45rem; }
  .what li { position: relative; padding-left: 1rem; color: var(--text-muted); font-size: 0.95rem; line-height: 1.55; }
  .what li::before { content: '▸'; position: absolute; left: 0; color: var(--c); }

  .side { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); gap: 1rem; }
  .side article {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: rgb(18 18 30 / 0.55);
    backdrop-filter: blur(10px);
  }
  .side .period { margin: 0; font-family: var(--font-mono); font-size: 0.72rem; color: var(--c); }
  .side h3 { margin: 0.35rem 0 0.5rem; font-size: 1.15rem; }
  .side p { color: var(--text-muted); font-size: 0.93rem; line-height: 1.55; margin: 0; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; margin: 0.9rem 0 0; }
  .chips li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25em 0.7em;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--text);
    background: rgb(255 255 255 / 0.03);
  }
  .chips.soft li { color: var(--text-muted); }

  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  .school { margin: 0; font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; }
  .degree { margin: 0.3rem 0 0; color: var(--text-muted); font-size: 0.92rem; }
  .talks { margin: 1rem 0 0; font-size: 0.85rem; color: var(--text-muted); }

  .foot { margin-top: 5rem; text-align: center; }
  .foot p { margin: 0 0 1rem; font-family: var(--font-display); font-size: 1.4rem; }
  @media (max-width: 700px) {
    .timeline > li { grid-template-columns: 1fr; gap: 0.4rem; }
    .when { grid-auto-flow: column; justify-content: start; gap: 0.75rem; }
    .split { grid-template-columns: 1fr; gap: 3.5rem; }
  }
</style>
