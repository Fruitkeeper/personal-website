---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/content';
import { formatDate, isoDate, readingTime } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<Base title={title} description={description} type="article">
  <article class="container post">
    <a href="/blog" class="back arrow-link"><span>←</span> All posts</a>
    <header>
      <div class="meta">
        <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)} min read</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time>
              </span>
            </>
          )
        }
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .post { max-width: 46rem; padding-block: 3rem 6rem; }
  .back { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2.5rem; }
  .back:hover span { transform: translateX(-4px); }
  header { margin-block: 2rem 3rem; padding-bottom: 2rem; border-bottom: 1px solid var(--border); }
  h1 { font-size: clamp(2.25rem, 6vw, 3.5rem); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem; }
  .lede { font-size: 1.2rem; color: var(--text-muted); }
  .tags { display: flex; gap: 0.4rem; list-style: none; padding: 0; margin: 0; }

  .prose :global(h2) { font-size: 1.75rem; margin-top: 2.5em; }
  .prose :global(h3) { margin-top: 2em; }
  .prose :global(a) { color: var(--accent-2); }
  .prose :global(blockquote) { margin: 1.5em 0; padding-left: 1.25em; border-left: 3px solid var(--accent-1); color: var(--text-muted); }
  .prose :global(pre) { margin-block: 1.5em; }
  .prose :global(hr) { border: 0; height: 1px; background: var(--border); margin-block: 3em; }
  .prose :global(img) { border-radius: var(--radius); }
</style>
