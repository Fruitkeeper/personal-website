---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
---

<Base visual="writing" title="Writing" description="Notes, essays and things I've learned.">
  <PageHeader eyebrow="Writing" title="Notes & essays" lede="Things I've learned, building in public." />
  <section class="container page-body">
    <PostList posts={posts} />
  </section>
</Base>

<style>
  .page-body { padding-bottom: 6rem; max-width: 52rem; margin-inline: 0; }
  @media (min-width: 72rem) { .page-body { margin-inline: auto; max-width: var(--max-width); } }
</style>
