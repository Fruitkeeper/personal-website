---
import Base from '../layouts/Base.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import PageHeader from '../components/PageHeader.astro';
import { projects } from '../config/site';
---

<Base title="Projects" description="Things I've built, shipped and tinkered with.">
  <PageHeader eyebrow="Work" title="Projects" lede="Things I've built, shipped and tinkered with." />
  <section class="container page-body">
    <ProjectGrid projects={projects} />
  </section>
</Base>

<style>
  .page-body { padding-bottom: 6rem; }
</style>
