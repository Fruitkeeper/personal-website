{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.luisgomezacebo.com" }],
      "destination": "https://luisgomezacebo.com/:path",
      "permanent": true
    }
  ]
}
